# Configuration de la base de données
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=medecin
DB_USERNAME=root
DB_PASSWORD=

# Configuration de l'application
APP_NAME=Pharmacie ERP
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/medecin

# Configuration de la session
SESSION_LIFETIME=3600
SESSION_PATH=/tmp
SESSION_COOKIE_NAME=pharmacie_session

# Configuration du cache
CACHE_DRIVER=file
CACHE_PREFIX=pharmacie_
CACHE_LIFETIME=3600

# Configuration des logs
LOG_CHANNEL=stack
LOG_PATH=/logs
LOG_LEVEL=debug

# Configuration de l'email
MAIL_DRIVER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@pharmacie.com
MAIL_FROM_NAME=Pharmacie ERP

# Configuration de la sécurité
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=3600
CSRF_TOKEN_EXPIRE=3600

# Configuration des fichiers
UPLOAD_PATH=/uploads
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,pdf,doc,docx,xls,xlsx

# Configuration de la caisse
CAISSE_SESSION_TIMEOUT=7200
CAISSE_Z_AUTO_GENERATE=true
CAISSE_PRINT_TICKET=true

# Configuration du stock
STOCK_ALERT_THRESHOLD=10
STOCK_SECURITY_THRESHOLD=5
STOCK_PEREMPTION_ALERT_DAYS=90

# Configuration SYSCOA
SYSCOA_EXERCICE=2024
SYSCOA_JOURNAL_PREFIX=JRN
SYSCOA_COMPTE_PREFIX=COMP
